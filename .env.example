# Copy this file to .env and fill in what you have. Every one of these is
# optional -- ZivaWhite degrades gracefully to whatever subset is
# configured (with no web search backend at all, it just answers from the
# local model only; see router.py).
#
# .env is loaded automatically (zivawhite/__init__.py calls
# python-dotenv on import) -- just save the file and restart the server,
# no manual `export`/`set` needed. A variable already set in your real
# shell environment always wins over the same name in .env.
#
# There used to be a section here for wiring in an external AI-model API
# (Anthropic/Gemini/OpenAI-compatible/any custom REST endpoint) as a
# "wrapper" the router could delegate answer-writing to. That's been
# removed on purpose -- every answer this project produces now comes
# from its own trained weights, not from another company's model. See
# README.md#removed-the-ai-api-wrapper.

# -- Web search (pick ONE) --------------------------------------------------
# Used for grounding ("what's the weather today") and by `autolearn`
# (zivawhite/autolearn.py) to find pages to train on -- never to have
# another model write the answer. See data/sources.py for the
# license allow-list that gates what actually reaches a training shard.
#
# Preferred: self-hosted SearxNG, no per-query limit or cost.
#   docker run -d --name searxng -p 8888:8888 searxng/searxng
# Without ONE of these two set, the web route finds nothing and queries that
# mention "today", "latest", "news" etc. fall back to the local model.
# SearxNG must have the JSON format enabled (settings.yml: search.formats: [html, json]).
SEARXNG_URL=http://localhost:8888

# Fallback: any commercial JSON search API (Bing/Google CSE/SerpAPI/etc.)
SEARCH_API_URL=
SEARCH_API_KEY=

# -- HTTP server (zivawhite.app serve) -----------------------------------
# All three below are opt-in and OFF by default, so launch.py keeps working
# with zero setup on localhost. Set them before
# exposing the server beyond your own machine -- see security.py. These
# protect the SERVER (who can call it, how often); they are separate
# from, and unaffected by, the model-capacity caps that were removed
# from AskBody/GenBody in app.py -- see README.md#removed-the-artificial-
# limits-on-the-model.

# If set, the /v1 endpoints require this exact value as a Bearer token
# (Authorization: Bearer <value>). Unset = no auth at all. DEVICE CONTROL
# (POST /v1/assistant running "volume up", "open calculator", ...) works only
# from this machine, or from a caller presenting this key -- so set it before
# exposing the server to your network, and ALWAYS set it behind a reverse proxy.
ZIVAWHITE_SERVER_API_KEY=

# "<requests>/<seconds>" per client IP. Default matches this line if unset.
# Set the request count to 0 to disable.
ZIVAWHITE_RATE_LIMIT=60/60

# Browser origins allowed to call the HTTP API from another page.
# Leave unset: only pages on localhost / 127.0.0.1 may (the bundled web UI is
# same-origin and needs nothing). Set to a comma-separated list of origins to
# allow specific sites, or to * to allow every website (not recommended).
# ZIVAWHITE_CORS_ORIGINS=

# Only set this if a reverse proxy YOU run sits in front of the server and sets
# X-Forwarded-For. Otherwise a client can put any IP in that header and dodge the
# rate limit, so it is ignored by default.
# ZIVAWHITE_TRUST_PROXY=1

# Page fetches refuse localhost / private-network / cloud-metadata addresses
# (SSRF guard). Set to 1 only if you deliberately want the fetch connector to
# reach machines on your own LAN.
# ZIVAWHITE_ALLOW_PRIVATE_FETCH=1

# -- Where your training data lives ------------------------------------------
# Default is the datasets/ folder next to this file (configs/ziva.yaml: paths.datasets).
# Point somewhere else (another drive, a network share) with:
# ZIVAWHITE_DATASETS=D:/my-training-data

# -- Use a different settings file instead of configs/ziva.local.yaml ----------
# ZIVAWHITE_CONFIG=/path/to/my-settings.yaml

# -- Smart home (optional): "turn off the living room light" -------------------
# Home Assistant long-lived access token (Profile -> Security). Then set
# device_control.smart_home.enabled: true and map the names you will say to
# entity ids in configs/ziva.local.yaml. Kept here, not in the YAML, so the
# YAML is safe to share.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
