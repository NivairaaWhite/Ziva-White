# Copy this file to .env and fill in what you have. Every one of these is
# optional -- ZivaWhite degrades gracefully to whatever subset is
# configured (with no web search backend at all, it just answers from the
# local model only; see router.py).
#
# .env is loaded automatically on import -- just save the file and restart
# the server, no manual `export`/`set` needed. Only ONE file is read: the
# .env in the folder you run ZivaWhite from (or the project folder), or the
# file named by ZIVAWHITE_ENV_FILE. Parent folders are never searched.
# A variable already set in your real shell environment always wins over the
# same name in .env.
# ZIVAWHITE_ENV_FILE=/path/to/my.env
#
# There used to be a section here for wiring in an external AI-model API
# (Anthropic/Gemini/OpenAI-compatible/any custom REST endpoint) as a
# "wrapper" the router could delegate answer-writing to. That's been
# removed on purpose -- every answer this project produces now comes
# from its own trained weights, not from another company's model. See
# docs/ROUTER.md ("Removed: the AI-API wrapper").

# -- Web search (pick ONE) --------------------------------------------------
# Used for grounding ("what's the weather today") and by `autolearn`
# (zivawhite/autolearn.py) to find pages to train on -- never to have
# another model write the answer. See data/sources.py for the
# license allow-list that gates what actually reaches a training shard.
#
# Preferred: self-hosted SearxNG, no per-query limit or cost.
#   docker run -d --name searxng -p 8888:8888 searxng/searxng
# Without ONE of these two set, the web route finds nothing and queries that
# mention "today", "latest", "news" etc. fall back to the local model.
# SearxNG must have the JSON format enabled (settings.yml: search.formats: [html, json]).
# It is commented out on purpose: with it active, `health` would report web search as
# configured even when nothing is running on that port. Uncomment once SearxNG is up.
# SEARXNG_URL=http://localhost:8888

# Fallback: a commercial search API. Each provider has its own request and response shape,
# so name yours (or let it be recognised from SEARCH_API_URL):
#   brave        Brave Search API   (recommended; key goes in a header, not the URL)
#   serpapi      SerpAPI            (the provider puts the key in the URL: it is scrubbed from our messages)
#   google_cse   Google Custom Search JSON API -- also needs SEARCH_API_CX. Closed to new customers,
#                switched off by Google on 2027-01-01.
#   generic      your own proxy answering {"results": [{"title", "url", "snippet"}]}; key sent as a Bearer token
# (Bing's search API no longer exists: Microsoft shut it down on 2025-08-11.)
# SEARCH_API_PROVIDER=brave
# SEARCH_API_URL=            # optional for brave / serpapi / google_cse: their standard address is used
# SEARCH_API_KEY=
# SEARCH_API_CX=             # google_cse only: your search engine id

# Identify your crawler to the sites it reads (a URL or an email). Sent in the User-Agent of page fetches.
# Nothing is advertised if you leave it unset.
# ZIVAWHITE_BOT_CONTACT=https://example.com/about-my-bot

# -- HTTP server (zivawhite.app serve) -----------------------------------
# The first three below are opt-in and OFF by default, so launch.py keeps working
# with zero setup on localhost. Set them before
# exposing the server beyond your own machine -- see security.py. These
# protect the SERVER (who can call it, how often); they are separate
# from, and unaffected by, the model-capacity caps that were removed
# from the model itself -- see docs/HTTP_API.md ("Removed: the artificial limits on the model").
# Request-size and generation-length limits for the server are in configs/ziva.yaml (limits:).

# If set, the /v1 endpoints require this exact value as a Bearer token
# (Authorization: Bearer <value>). Unset = no auth at all. DEVICE CONTROL
# (POST /v1/assistant running "volume up", "open calculator", ...) works only
# from this machine, or from a caller presenting this key -- so set it before
# exposing the server to your network, and ALWAYS set it behind a reverse proxy.
ZIVAWHITE_SERVER_API_KEY=

# "<requests>/<seconds>" per client IP. Default matches this line if unset.
# Set the request count to 0 to disable.
ZIVAWHITE_RATE_LIMIT=60/60

# Wrong-key lock-out: "<failures>/<seconds>" per client. After that many WRONG keys the client is
# answered 429 (even with the right key) until the window passes. Right keys never count.
# Default matches this line if unset; set the count to 0 to disable.
ZIVAWHITE_AUTH_FAIL_LIMIT=10/60

# Host names this server answers to, besides localhost and IP addresses (a defence against DNS
# rebinding: a web page that re-points its own name at 127.0.0.1 must not be able to talk to the
# server). Comma-separated. Needed only if you reach the server by a NAME, e.g. my-pc.local.
# ZIVAWHITE_ALLOWED_HOSTS=my-pc.local

# Largest request body, in bytes (default 1000000; 0 = no limit). Same as limits.max_body_bytes.
# ZIVAWHITE_MAX_BODY_BYTES=1000000

# Browser origins allowed to call the HTTP API from another page.
# Leave unset: only pages on localhost / 127.0.0.1 may (the bundled web UI is
# same-origin and needs nothing). Set to a comma-separated list of origins to
# allow specific sites, or to * to allow every website (not recommended).
# ZIVAWHITE_CORS_ORIGINS=

# Only set this if a reverse proxy YOU run sits in front of the server and sets
# X-Forwarded-For. Otherwise a client can put any IP in that header and dodge the
# rate limit, so it is ignored by default.
# ZIVAWHITE_TRUST_PROXY=1

# Page fetches refuse localhost / private-network / cloud-metadata addresses
# (SSRF guard). Set to 1 only if you deliberately want the fetch connector to
# reach machines on your own LAN.
# ZIVAWHITE_ALLOW_PRIVATE_FETCH=1

# -- Where your training data lives ------------------------------------------
# Default is the datasets/ folder next to this file (configs/ziva.yaml: paths.datasets).
# Put prose in datasets/text/ and conversations in datasets/chat/ -- see datasets/README.md.
# Point somewhere else (another drive, a network share) with:
# ZIVAWHITE_DATASETS=D:/my-training-data

# -- Where "the project folder" is (datasets/, data/, runs/, configs/ziva.local.yaml) ---
# Source checkout: it is the checkout. After `pip install`: the folder you run the command from.
# Set this to pin it somewhere else.
# ZIVAWHITE_HOME=/path/to/my-ziva

# -- Loading model files ----------------------------------------------------------
# Checkpoints are read with torch's safe loader (no code can run from a .pt file). A file that
# needs full pickle -- only an int8 file written by an OLD `compress` -- is refused. If you made such
# a file yourself and trust it, set this to 1; better, re-run `compress` to write the safe format.
# ZIVAWHITE_ALLOW_PICKLE=1

# -- Use a different settings file instead of configs/ziva.local.yaml ----------
# ZIVAWHITE_CONFIG=/path/to/my-settings.yaml

# -- Smart home (optional): "turn off the living room light" -------------------
# Home Assistant long-lived access token (Profile -> Security). Then set
# device_control.smart_home.enabled: true and map the names you will say to
# entity ids in configs/ziva.local.yaml. Kept here, not in the YAML, so the
# YAML is safe to share.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
